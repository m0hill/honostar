{
  "name": "honostar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter honostar-starter dev",
    "dev:starter": "pnpm --filter honostar-starter dev",
    "dev:demo": "pnpm --filter honostar-demo dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "format": "biome check --write .",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/node": "^22.10.1",
    "oxlint": "^1.28.0",
    "oxlint-tsgolint": "^0.6.0",
    "typescript": "^5.9.3"
  }
}
