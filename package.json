{
  "scripts": {
    "start": "bun run build:css && bun src/index.ts",
    "dev": "bunx concurrently \"bun run dev:css\" \"bun --hot src/index.ts\"",
    "build": "bun run build:css && bun build src/index.ts --outdir dist --target bun",
    "build:prod": "bun run build:css && bun build src/index.ts --outdir dist --target bun --minify --release",
    "build:css": "tailwindcss -i ./styles.css -o ./public/styles.css",
    "dev:css": "tailwindcss -i ./styles.css -o ./public/styles.css --watch",
    "lint": "oxlint --type-aware",
    "format": "biome check --write .",
    "typecheck": "tsc -noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start:prod": "bun dist/index.js",
    "check": "bun run format && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.3",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.7",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@tailwindcss/cli": "^4.1.13",
    "@types/bun": "latest",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "oxlint": "^1.16.0",
    "oxlint-tsgolint": "^0.2.0",
    "tailwindcss": "^4.1.13"
  }
}
