{
  "rules": {
    "no-alert": "error",
    "oxc/approx-constant": "warn",
    "no-plusplus": "off"
  },
  "plugins": ["unicorn", "typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["datastar.js", "src/core/route.ts", "**/*.test.ts"],
  "env": {
    "browser": true,
    "node": true
  }
}
