{
  "name": "@honostar/cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "honostar": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-node-esm-imports.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json"
  },
  "dependencies": {
    "@honostar/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "oxlint": "^1.28.0",
    "oxlint-tsgolint": "^0.6.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "vite": "^6"
  }
}
