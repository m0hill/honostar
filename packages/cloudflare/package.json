{
  "name": "@honostar/cloudflare",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-node-esm-imports.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json"
  },
  "dependencies": {
    "@honostar/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260131.0",
    "hono": "^4.11.7",
    "oxlint": "^1.28.0",
    "oxlint-tsgolint": "^0.6.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "hono": "^4"
  }
}
