{
  "name": "honostar-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "honostar dev",
    "start": "honostar start",
    "build": "honostar build && bun build src/index.ts --outdir dist --target bun",
    "build:prod": "honostar build && bun build src/index.ts --outdir dist --target bun --minify --release",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json",
    "typecheck": "honostar prepare && tsc -noEmit",
    "test": "honostar prepare && bun test --pass-with-no-tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start:prod": "honostar prepare && HONOSTAR_VITE_MANIFEST_PATH=dist/manifest.json bun dist/index.js",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.1.5",
    "@honostar/core": "workspace:*",
    "@honostar/logging": "workspace:*",
    "@honostar/standard": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@standard-schema/spec": "^1.0.0",
    "better-sqlite3": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.7",
    "ioredis": "^5.4.1",
    "nats": "^2.29.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@honostar/cli": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "latest",
    "@types/node": "^22.10.1",
    "drizzle-kit": "^0.31.4",
    "oxlint": "^1.28.0",
    "oxlint-tsgolint": "^0.6.0",
    "rollup": "^4.57.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.7.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "honostar": {
    "depsBuild": [
      "@honostar/core",
      "@honostar/logging",
      "@honostar/inspector",
      "@honostar/standard"
    ],
    "routes": {
      "pagesDir": "src/pages",
      "manifestPath": "src/generated/routes.manifest.ts",
      "routesPath": "src/generated/routes.ts",
      "configPath": "scripts/routes.config.json",
      "serverImportPath": "@honostar/core/server"
    },
    "contracts": {
      "contractsImportPath": "../lib/contracts",
      "outPath": "src/generated/contracts.ts",
      "serverImportPath": "@honostar/core/server"
    },
    "server": {
      "dev": "bun --hot src/index.ts",
      "start": "bun src/index.ts"
    }
  }
}
