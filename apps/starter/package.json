{
  "name": "honostar-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "routes:generate": "pnpm --filter @honostar/core build && tsx scripts/generate-routes.ts",
    "build:runtime": "pnpm --filter @honostar/core build && esbuild src/client.ts --bundle --format=esm --platform=browser --outfile=public/runtime.js",
    "dev": "pnpm routes:generate && pnpm build:runtime && tsx watch src/index.ts",
    "start": "pnpm routes:generate && pnpm build:runtime && tsx src/index.ts",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json",
    "typecheck": "pnpm --filter @honostar/core build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@honostar/core": "workspace:*",
    "hono": "^4.9.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.25.0",
    "oxlint": "^1.28.0",
    "oxlint-tsgolint": "^0.6.0",
    "tsx": "^4.7.2",
    "typescript": "^5.9.3"
  }
}
