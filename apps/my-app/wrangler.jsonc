{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-app",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "durable_objects": {
    "bindings": [
      {
        "name": "HONOSTAR_SSE_HUB",
        "class_name": "CloudflareBusHub",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CloudflareBusHub"],
    },
  ],
}
